# /srv/mahjong-records/.env 의 꼴(값은 서버에서 채운다. 이 파일에 실제 값을 넣지 말 것).
# DB 는 공용 postgres 의 database mahjong · role mahjong(/srv/db/.env.mahjong 의 값). 표는 schema app 에 만든다.
DATABASE_URL=postgresql://mahjong:<비밀번호>@postgres:5432/mahjong
# python scripts/hash_password.py 로 만든 한 줄(scrypt:...).
ADMIN_PASSWORD_HASH=
# 세션 쿠키 서명 키: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
